#!/bin/sh

# The package lists of many custom exam environments can be minimized even
# further. If you are building such a minimized exam environment you can just
# comment out the exit statement below.

apt purge -y \
	baobab \
	gnome-calculator \
	gnome-characters \
	gnome-clocks \
	gnome-disk-utility \
	gnome-font-viewer \
	gnome-logs \
	gnome-software \
	gnome-system-monitor \
	gnome-tweaks
