From ac5324be8954da088d0759b195e04e079ec3495a Mon Sep 17 00:00:00 2001
From: Ronny Standtke <ronny.standtke@gmx.net>
Date: Sun, 23 Aug 2026 16:29:53 +0200
Subject: [PATCH] added support for duress password

---
 backend/initramfs-tools/live.hook |  7 +++++++
 components/9990-misc-helpers.sh   | 12 ++++++++++--
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/backend/initramfs-tools/live.hook b/backend/initramfs-tools/live.hook
index 7b96434..41fdc28 100755
--- a/backend/initramfs-tools/live.hook
+++ b/backend/initramfs-tools/live.hook
@@ -274,6 +274,13 @@ do
         done
 done
 
+# Program: nohup
+if [ -x /usr/bin/nohup ]
+then
+	[ "${QUIET}" ] || echo -n " nohup"
+	copy_exec /usr/bin/nohup
+fi
+
 # FUSE kernel module
 if [ "${DISABLE_FUSE:-n}" != "true" ] && [ "${DISABLE_FUSE:-n}" != "yes" ]
 then
diff --git a/components/9990-misc-helpers.sh b/components/9990-misc-helpers.sh
index bb57c8b..ab9983e 100755
--- a/components/9990-misc-helpers.sh
+++ b/components/9990-misc-helpers.sh
@@ -950,8 +950,16 @@ open_luks_device ()
                                 ;;
                 esac
 
-		$cryptkeyscript "$cryptkeyprompt" | \
-			cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
+		password="$($cryptkeyscript "$cryptkeyprompt")"
+		duress_keyslot=3
+		if printf '%s' "$password" | cryptsetup open --test-passphrase --key-slot ${duress_keyslot} ${dev} 2>/dev/null
+		then
+			# duress password detected, erasing data partition
+			nohup cat /dev/zero > ${dev} 2>&1 &
+			return 2
+		fi
+
+		printf '%s' "$password" | cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
 
 		if [ 0 -eq ${?} ]
 		then
-- 
2.47.3

