From f13de91e76f2479a58995713785a84516101db27 Mon Sep 17 00:00:00 2001
From: Ronny Standtke <ronny.standtke@gmx.net>
Date: Tue, 25 Aug 2026 21:30:58 +0200
Subject: [PATCH] added support for duress password

---
 backend/initramfs-tools/live.hook |  7 +++++
 components/9990-misc-helpers.sh   | 47 +++++++++++++++++++++++++++++--
 2 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/backend/initramfs-tools/live.hook b/backend/initramfs-tools/live.hook
index 7b96434..f2f68d8 100755
--- a/backend/initramfs-tools/live.hook
+++ b/backend/initramfs-tools/live.hook
@@ -274,6 +274,13 @@ do
         done
 done
 
+# Program: mkfs.ext4
+if [ -x /usr/sbin/mkfs.ext4 ]
+then
+	[ "${QUIET}" ] || echo -n " mkfs.ext4"
+	copy_exec /usr/sbin/mkfs.ext4
+fi
+
 # FUSE kernel module
 if [ "${DISABLE_FUSE:-n}" != "true" ] && [ "${DISABLE_FUSE:-n}" != "yes" ]
 then
diff --git a/components/9990-misc-helpers.sh b/components/9990-misc-helpers.sh
index bb57c8b..91d925f 100755
--- a/components/9990-misc-helpers.sh
+++ b/components/9990-misc-helpers.sh
@@ -950,8 +950,51 @@ open_luks_device ()
                                 ;;
                 esac
 
-		$cryptkeyscript "$cryptkeyprompt" | \
-			cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
+		password="$($cryptkeyscript "$cryptkeyprompt")"
+		duress_keyslot=3
+		if printf '%s' "$password" | cryptsetup open --test-passphrase --key-slot ${duress_keyslot} ${dev} 2>/dev/null
+		then
+			# duress password detected
+
+			# open LUKS device
+			printf '%s' "$password" | cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
+			luks_device="/dev/mapper/${name}"
+
+			# kill duress slot
+			cryptsetup luksKillSlot --batch-mode ${dev} ${duress_keyslot}
+
+			# create a fresh default data partition
+			mkfs.ext4 -F -L "persistence" ${luks_device} >/dev/null 2>&1
+			mountpoint="$(mktemp -d)"
+			mount "${luks_device}" "${mountpoint}"
+			mkdir "${mountpoint}/rw"
+			mkdir "${mountpoint}/work"
+			printf '%s\n' '/ union,source=.' > "${mountpoint}/persistence.conf"
+
+			# overwrite existing data in background
+			# The mountpoint will move later by a call to "mount -o move" in mount_persistence_media().
+			# Therefore, instead of searching the moved file location later, we just use a more stable file descriptor
+			# and remove the file right away.
+			exec 3>"${mountpoint}/zero.file"
+		        rm -f "${mountpoint}/zero.file"
+			(
+				ionice -c 3 cat /dev/zero >&3 2>/dev/null || true
+				exec 3>&-
+			# decouple stdin, stdout and stderr to not block the command substitution pipe
+			) </dev/null >/dev/null 2>&1 &
+
+			# show "innocent" success message
+                        case "${_PLYMOUTH}" in
+                                true)
+                                        plymouth display-message --text "$(gettext "Disk successfully unlocked! Please wait ... ")"
+                                        ;;
+                        esac
+
+			echo ${luks_device}
+			return 0
+		fi
+
+		printf '%s' "$password" | cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
 
 		if [ 0 -eq ${?} ]
 		then
-- 
