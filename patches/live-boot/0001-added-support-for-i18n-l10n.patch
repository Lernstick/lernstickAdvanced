From f697697637133b13b3ac08a38aab9c963e5f2b57 Mon Sep 17 00:00:00 2001
From: Ronny Standtke <ronny.standtke@gmx.net>
Date: Sun, 16 Aug 2026 01:19:01 +0200
Subject: [PATCH] added support for i18n & l10n

---
 Makefile                          |  7 +++-
 backend/initramfs-tools/live.hook | 56 ++++++++++++++++++++++++++++++
 components/9990-misc-helpers.sh   | 31 ++++++++++++++---
 debian/control                    |  3 ++
 debian/rules                      | 13 +++++++
 po/de.po                          | 57 +++++++++++++++++++++++++++++++
 update_po.sh                      | 22 ++++++++++++
 7 files changed, 183 insertions(+), 6 deletions(-)
 create mode 100644 po/de.po
 create mode 100755 update_po.sh

diff --git a/Makefile b/Makefile
index 8f1595e..48814b3 100644
--- a/Makefile
+++ b/Makefile
@@ -4,6 +4,8 @@ SHELL := sh -e
 
 LANGUAGES = $(shell cd manpages/po && ls)
 
+MO_FILES = $(patsubst po/%.po,po/%.mo,$(wildcard po/*.po))
+
 SCRIPTS = backend/*/* frontend/* components/*
 
 all: build
@@ -37,9 +39,12 @@ test:
 		echo "I:   apt-get install devscripts"; \
 	fi
 
-build:
+build: $(MO_FILES)
 	$(MAKE) -C $(CURDIR)/manpages
 
+po/%.mo: po/%.po
+	msgfmt $< -o $@
+
 install:
 	# Installing components
 	mkdir -p $(DESTDIR)/usr/lib/live/boot
diff --git a/backend/initramfs-tools/live.hook b/backend/initramfs-tools/live.hook
index 3693a4b..7b96434 100755
--- a/backend/initramfs-tools/live.hook
+++ b/backend/initramfs-tools/live.hook
@@ -218,6 +218,62 @@ then
 	copy_exec /sbin/blockdev
 fi
 
+# Program: gettext
+if [ -x /usr/bin/gettext ]
+then
+	[ "${QUIET}" ] || echo -n " gettext"
+	copy_exec /usr/bin/gettext
+fi
+
+# Message catalogs
+for _MO in /usr/share/locale/*/LC_MESSAGES/live-boot.mo
+do
+	[ -f "${_MO}" ] || continue
+
+	_RELATIVE="${_MO#/usr/share/locale/}"
+
+	mkdir -p "${DESTDIR}/usr/share/locale/$(dirname "${_RELATIVE}")"
+
+	cp -p "${_MO}" \
+		"${DESTDIR}/usr/share/locale/${_RELATIVE}"
+done
+
+# Locale data
+for _MO in /usr/share/locale/*/LC_MESSAGES/live-boot.mo
+do
+	[ -f "${_MO}" ] || continue
+
+	# Extract language from /usr/share/locale/<language>/...
+	_LANG="${_MO#/usr/share/locale/}"
+	_LANG="${_LANG%%/*}"
+
+	# Include all locale variants for this language.
+	for _LOCALE in /usr/lib/locale/"${_LANG}"*
+	do
+		[ -d "${_LOCALE}" ] || continue
+
+		_LOCALE="${_LOCALE##*/}"
+
+		# Copy the locale directory, preserving symbolic links.
+		mkdir -p "${DESTDIR}/usr/lib/locale"
+		cp -a "/usr/lib/locale/${_LOCALE}" \
+			"${DESTDIR}/usr/lib/locale/"
+
+		# Copy targets of symbolic links.
+		find "/usr/lib/locale/${_LOCALE}" -type l |
+		while read -r _LINK
+		do
+			_TARGET="$(readlink -f "${_LINK}")"
+
+			[ -e "${_TARGET}" ] || continue
+			[ -e "${DESTDIR}${_TARGET}" ] && continue
+
+			mkdir -p "${DESTDIR}$(dirname "${_TARGET}")"
+			cp -a "${_TARGET}" "${DESTDIR}${_TARGET}"
+                done
+        done
+done
+
 # FUSE kernel module
 if [ "${DISABLE_FUSE:-n}" != "true" ] && [ "${DISABLE_FUSE:-n}" != "yes" ]
 then
diff --git a/components/9990-misc-helpers.sh b/components/9990-misc-helpers.sh
index 0a7bf24..1920ecc 100755
--- a/components/9990-misc-helpers.sh
+++ b/components/9990-misc-helpers.sh
@@ -2,6 +2,10 @@
 
 #set -e
 
+# gettext support
+. gettext.sh
+export TEXTDOMAIN=live-boot
+
 is_live_path()
 {
 	DIRECTORY="${1}/${LIVE_MEDIA_PATH}"
@@ -910,40 +914,57 @@ open_luks_device ()
 		_PLYMOUTH="true"
 	fi
 
+	vendor="$(cat /sys/block/$(basename ${dev%%[0-9]})/device/vendor | xargs)"
+	model="$(cat /sys/block/$(basename ${dev%%[0-9]})/device/model | xargs)"
+	partition="$(cat /sys/block/$(basename ${dev%%[0-9]})/$(basename ${dev})/partition)"
+
 	case "${_PLYMOUTH}" in
 		true)
 			plymouth --ping
 
 			cryptkeyscript="plymouth ask-for-password --prompt"
 			# Plymouth will add a : if it is a non-graphical prompt
-			cryptkeyprompt="Please unlock disk ${dev}"
+			cryptkeyprompt="$(eval_gettext "Please unlock disk \$vendor \$model partition \$partition (\$dev)")"
 			;;
 
 		*)
 			cryptkeyscript="/lib/cryptsetup/askpass"
-			cryptkeyprompt="Please unlock disk ${dev}: "
+			cryptkeyprompt="$(eval_gettext "Please unlock disk \$vendor \$model partition \$partition (\$dev): ")"
 			;;
 	esac
 
 	while true
 	do
+
+                case "${_PLYMOUTH}" in
+                        true)
+                                plymouth display-message --text "$(eval_gettext "The current keyboard layout is \$LAYOUT.")"
+                                ;;
+                esac
+
 		$cryptkeyscript "$cryptkeyprompt" | \
 			cryptsetup -T 1 luksOpen ${dev} ${name} ${opts}
 
 		if [ 0 -eq ${?} ]
 		then
+                        case "${_PLYMOUTH}" in
+                                true)
+                                        plymouth display-message --text "$(gettext "Disk successfully unlocked! Please wait ... ")"
+                                        ;;
+                        esac
+
 			luks_device="/dev/mapper/${name}"
 			echo ${luks_device}
 			return 0
 		fi
 
 		echo >&6
-		retryprompt="There was an error decrypting ${dev} ... Retry? [Y/n]"
+		retryprompt="$(eval_gettext "There was an error decrypting \$vendor \$model partition \$partition (\$dev) ... Retry? [Y/n]")"
 
 		case "${_PLYMOUTH}" in
 			true)
 				plymouth display-message --text "${retryprompt}"
-				answer=$(plymouth watch-keystroke --keys="YNyn")
+				answer=$(plymouth watch-keystroke --keys=$(gettext "YNyn"))
 				;;
 
 			*)
@@ -952,7 +973,7 @@ open_luks_device ()
 				;;
 		esac
 
-		if [ "$(echo "${answer}" | cut -b1 | tr A-Z a-z)" = "n" ]
+		if [ "$(echo "${answer}" | cut -b1 | tr A-Z a-z)" = $(gettext "n") ]
 		then
 			case "${_PLYMOUTH}" in
 				true)
