diff --git a/update_po.sh b/update_po.sh
new file mode 100755
index 0000000..7bda4ff
--- /dev/null
+++ b/update_po.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+
+# make sure to be in the correct directory
+SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
+cd "$SCRIPT_DIR" || exit 1
+
+# get all internationalized strings
+xgettext -L Shell --from-code UTF-8 --add-comments=## components/*
+sed -i "s/charset=CHARSET/charset=UTF-8/g" messages.po
+
+# merge update into all language specific po files
+cd "po" || exit 1
+for LANG in *
+do
+	cd "$LANG" || exit 1
+	msgmerge -U live-boot.po ../../messages.po
+	cd ..
+done
+cd ..
+
+# manually edit/update po files
+vi po/*/live-boot.po
